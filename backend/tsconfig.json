/* backend/tsconfig.json */
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*", ".ts"],
  "exclude": [
    "node_modules",
    "prisma/seedFinancials.ts",
    "prisma/seeds/financialTemplates.ts",
    "prisma/seeds/registrationRequirements.ts",
    "scripts/seedHeaders.ts",
    "services/financialAnalysisService.ts"
  ]
}